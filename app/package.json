{
  "name": "lazy-skill-ai-agent-app",
  "version": "0.8.0",
  "description": "Standalone desktop application to manage AI skills and rules for Claude Code, Antigravity, Cursor, and ZCode (z.ai)",
  "main": "out/main.js",
  "author": "dn9uy3n",
  "license": "MIT",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/test/*.test.js",
    "start": "npm run compile && electron .",
    "build:win": "npm run compile && electron-builder --win",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:linux": "npm run compile && electron-builder --linux",
    "build:all": "npm run compile && electron-builder -mwl"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.dn9uy3n.lazy-skill-ai-agent",
    "productName": "Lazy Skill AI Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/test/**",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["tar.gz"],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
