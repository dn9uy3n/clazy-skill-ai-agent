{
  "name": "lazy-skill-ai-agent",
  "displayName": "Lazy Skill AI Agent",
  "description": "Manage AI skills and rules for Claude Code, Antigravity, Cursor, and ZCode (z.ai) projects",
  "version": "0.8.1",
  "publisher": "dn9uy3n",
  "repository": {
    "type": "git",
    "url": "https://github.com/dn9uy3n/lazy-skill-ai-agent"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lazy-skill.openManager",
        "title": "Lazy: Open Skill Manager"
      }
    ],
    "configuration": {
      "title": "Lazy Skill AI Agent",
      "properties": {
        "lazy-skill-ai-agent.skillDirectories": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Paths to directories whose subfolders are AI skills"
        },
        "lazy-skill-ai-agent.ruleFiles": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Paths to individual rule files (.md/.mdc/.txt) that can be added to a project"
        },
        "lazy-skill-ai-agent.targetPlatform": {
          "type": "string",
          "enum": ["claude-code", "antigravity", "cursor", "zcode"],
          "enumDescriptions": [
            "{project}/.claude/skills + .claude/rules",
            "{project}/.agent/skills + .agents/rules",
            "{project}/.cursor/skills + .cursor/rules",
            "{project}/.zcode/skills (no rules folder; rules merge into AGENTS.md)"
          ],
          "default": "claude-code",
          "description": "Which AI tool's workspace folders skills and rules are installed into"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
